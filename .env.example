# Copiar a .env. No guardar contraseñas en este archivo.
# Validado por server/config.ts (Zod) al iniciar: una variable con forma
# inválida detiene el arranque con un mensaje que nombra la variable y la
# causa, en vez de fallar más abajo con un síntoma indirecto.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# En despliegue HTTPS: COOKIE_SECURE=true y APP_ORIGIN=https://su-dominio
COOKIE_SECURE=false
# Carpeta base para los datos de la aplicación (por defecto ./data).
DATA_DIR=./data
# La base de demostración siempre usa <DATA_DIR>/demo.sqlite, ignora esta
# variable y no admite registros reales (ver server/config.ts).
DATABASE_PATH=./data/nexo.sqlite
# Carpeta donde `npm run db:backup` escribe las copias de seguridad
# (por defecto ./backups).
BACKUP_DIR=./backups
